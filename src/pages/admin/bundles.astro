---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="inDscent - Bundle Management">
  <link rel="stylesheet" href="/admin.css" slot="head" />
  <link rel="stylesheet" href="/admin-bundles.css?v=2" slot="head" />

  <div class="admin-header">
    <div class="admin-header-left">
      <img src="/assets/logo.jpg" alt="inDscent Logo" />
      <div class="admin-header-title">
        <h1>INDSCENT ADMIN</h1>
        <p>"Your Signature Identity In Every Drop"</p>
      </div>
    </div>
    <a href="/admin/login/" class="logout-btn" id="logout-btn">LOGOUT</a>
  </div>

  <div class="admin-nav">
    <a href="/admin/inbox/">INBOX</a>
    <a href="/admin/consolidated/">CONSOLIDATED</a>
    <a href="/admin/archived/">ARCHIVED</a>
    <a href="/admin/deleted/">DELETED</a>
    <a href="/admin/maintenance/">MAINTENANCE</a>
    <a href="/admin/bundles/" class="active">BUNDLES</a>
    <a href="/admin/suggestions/">SUGGESTIONS</a>
  </div>

  <div class="admin-section">

    <div class="admin-box" style="margin-bottom:2rem;">
      <div class="admin-box-title">CREATE NEW BUNDLE</div>
      <div class="admin-box-body">
        <div id="create-success" style="display:none;padding:0.6rem 1rem;background:#d4edda;color:#155724;font-weight:bold;border-radius:3px;margin-bottom:1rem;"></div>
        <div id="create-error" style="display:none;padding:0.6rem 1rem;background:#f8d7da;color:#721c24;font-weight:bold;border-radius:3px;margin-bottom:1rem;"></div>

        <div style="background:#f5f5f5;border:1px solid #ddd;border-radius:4px;padding:1rem;">
          <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
            <div style="flex:1;min-width:130px;">
              <label style="display:block;font-size:0.8rem;font-weight:bold;margin-bottom:0.3rem;color:#1a1a2e;">Bundle ID</label>
              <select id="new-bundle-id" style="width:100%;padding:0.5rem;border:1px solid #ccc;font-size:0.9rem;background:white;"></select>
            </div>
            <div style="flex:2;min-width:160px;">
              <label style="display:block;font-size:0.8rem;font-weight:bold;margin-bottom:0.3rem;color:#1a1a2e;">Bundle Name</label>
              <input type="text" id="new-bundle-name" placeholder="e.g. Bundle_17" style="width:100%;padding:0.5rem;border:1px solid #ccc;font-size:0.9rem;" />
            </div>
            <div style="flex:1;min-width:100px;">
              <label style="display:block;font-size:0.8rem;font-weight:bold;margin-bottom:0.3rem;color:#1a1a2e;">Price (R)</label>
              <input type="number" id="new-bundle-price" placeholder="e.g. 150" style="width:100%;padding:0.5rem;border:1px solid #ccc;font-size:0.9rem;" />
            </div>
          </div>

          <div style="margin-bottom:0.8rem;">
            <label style="display:block;font-size:0.8rem;font-weight:bold;margin-bottom:0.5rem;color:#1a1a2e;">Bundle Items</label>
            <div id="items-container"></div>
            <button onclick="addItemRow()" style="background:#2980b9;color:white;border:none;padding:0.4rem 0.9rem;cursor:pointer;font-size:0.85rem;border-radius:3px;margin-top:0.3rem;">+ Add Product Line</button>
          </div>

          <button onclick="createBundle()" style="background:#27ae60;color:white;border:none;padding:0.7rem 2rem;font-weight:bold;cursor:pointer;font-size:0.9rem;letter-spacing:1px;">CREATE BUNDLE</button>
        </div>
      </div>
    </div>

    <div class="admin-box">
      <div class="admin-box-title">
        <span>EXISTING BUNDLES</span>
        <span id="bundle-count"></span>
      </div>
      <div class="admin-box-body">
        <div id="bundles-list">
          <p class="loading-msg">Loading bundles...</p>
        </div>
        <div class="deploy-controls">
          <button id="deploy-changes-btn" class="deploy-button" type="button">Deploy Changes</button>
          <span id="deploy-status" class="deploy-status">No deployment in progress.</span>
        </div>
      </div>
    </div>

  </div>

  <script is:inline src="/admin-bundles-v2.js?v=2"></script>
</BaseLayout>