---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="inDscent - Maintenance">
  <link rel="stylesheet" href="/admin.css" slot="head" />

  <div class="admin-header">
    <div class="admin-header-left">
      <img src="/assets/logo.jpg" alt="inDscent Logo" />
      <div class="admin-header-title">
        <h1>INDSCENT ADMIN</h1>
        <p>"Your Signature Identity In Every Drop"</p>
      </div>
    </div>
    <a href="/admin/login" class="logout-btn" id="logout-btn">LOGOUT</a>
  </div>

  <div class="admin-nav">
    <a href="/admin/inbox">INBOX</a>
    <a href="/admin/consolidated">CONSOLIDATED</a>
    <a href="/admin/archived">ARCHIVED</a>
    <a href="/admin/deleted">DELETED</a>
    <a href="/admin/maintenance" class="active">MAINTENANCE</a>
    <a href="/admin/bundles/">BUNDLES</a>
    <a href="/admin/suggestions/">SUGGESTIONS</a>
  </div>
  <!-- EXPORT BOX -->
  <div class="admin-box">
    <div class="admin-box-title">DATABASE BACKUP & EXPORT</div>
    <div class="admin-box-body" style="margin-bottom: 1.5rem;">
      <p style="margin-bottom: 1rem; color: #555; font-size: 0.9rem;">
        Download your current live database tables into CSV backups before making massive changes.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <button class="login-btn" id="export-fragrances-btn" style="max-width:250px; background:#2c3e50; border-color:#2c3e50;">DOWNLOAD FRAGRANCES CSV</button>
        <button class="login-btn" id="export-products-btn" style="max-width:250px; background:#2c3e50; border-color:#2c3e50;">DOWNLOAD PRODUCTS CSV</button>
      </div>
      <div id="export-msg" style="margin-top:1rem; display:none; font-weight:bold;"></div>
    </div>
  </div>

  <!-- IMPORT BOX -->
  <div class="admin-box" style="margin-top:2rem;">
    <div class="admin-box-title">DATABASE LIVE SYNC MAINTENANCE</div>
    <div class="admin-box-body">
      <p style="margin-bottom:1rem; color:#555; font-size:0.9rem;">
        Upload your updated CSV file to refresh the catalog completely. The system automatically reads columns:
        <strong>name</strong>, <strong>gender</strong> (female/male), and optional <strong>active</strong> (1 = visible, 0 = hidden).
      </p>
      <p style="margin-bottom:1rem; color:#555; font-size:0.85rem;">
        Example Format:<br>
        <code>name, gender, active</code><br>
        <code>Chanel No 5, female, 1</code><br>
        <code>Dior Sauvage, male, 1</code>
      </p>

      <div class="form-group" style="margin-bottom:1rem;">
        <label style="display:block; font-weight:bold; margin-bottom:0.5rem; color:#1a1a2e;">Target Table Selection</label>
        <select id="import-target" style="width:100%; padding:0.5rem; border:1px solid #ccc; background:#fff; font-size:1rem;">
          <option value="fragrances">Fragrances Catalog</option>
          <option value="products">Products Catalog</option>
        </select>
      </div>

      <div class="form-group" style="margin-bottom:1rem;">
        <label style="display:block; font-weight:bold; margin-bottom:0.5rem; color:#1a1a2e;">Select Updated CSV File</label>
        <input type="file" id="csv-file" accept=".csv" style="width:100%; padding:0.5rem; border:1px solid #ccc;" />
      </div>

      <button class="login-btn" id="upload-btn" style="max-width:200px;">PUSH LIVE TO D1</button>
      <div id="upload-msg" style="margin-top:1rem; display:none; font-weight:bold;"></div>

      <div id="preview-container" style="margin-top:1.5rem; display:none;">
        <div class="admin-box-title" style="margin-bottom:0.5rem;">STAGING QUEUE PREVIEW</div>
        <div id="preview-table"></div>
      </div>
    </div>
  </div>

  <div class="admin-box" style="margin-top:2rem;">
    <div class="admin-box-title">BROCHURE PDF MAINTENANCE</div>
    <div class="admin-box-body">
      <p style="margin-bottom:1rem; color:#555; font-size:0.9rem;">
        Generate a brochure from the current catalogue, or upload a PDF to make it the live brochure. The previous version remains available.
      </p>
      <div style="display:flex; gap:1rem; flex-wrap: wrap;">
        <button class="login-btn" id="generate-brochure-btn" style="max-width:240px;">GENERATE PDF</button>
        <button class="login-btn" id="use-previous-brochure-btn" style="max-width:240px; background:#2c3e50; border-color:#2c3e50;">USE PREVIOUS PDF</button>
      </div>
      <div class="form-group" style="margin-top:1rem; max-width:520px;">
        <label for="brochure-upload-key" style="display:block; font-weight:bold; margin-bottom:0.5rem; color:#1a1a2e;">PDF management key</label>
        <input id="brochure-upload-key" type="password" autocomplete="off" placeholder="Enter the Cloudflare brochure key" style="width:100%; padding:0.6rem; border:1px solid #ccc;" />
        <label for="brochure-file" style="display:block; font-weight:bold; margin:1rem 0 0.5rem; color:#1a1a2e;">Upload a PDF as the live brochure (max 1 MB)</label>
        <input id="brochure-file" type="file" accept="application/pdf,.pdf" style="width:100%; padding:0.5rem; border:1px solid #ccc;" />
      </div>
      <button class="login-btn" id="upload-brochure-btn" style="max-width:240px; margin-top:0.5rem;">UPLOAD PDF</button>
      <div id="brochure-msg" style="margin-top:1rem; display:none; font-weight:bold;"></div>
    </div>
  </div>

  <!-- CLEANUP BOX -->
  <div class="admin-box" style="margin-top:2rem;">
    <div class="admin-box-title">ORDER LIST CLEANUP</div>
    <div class="admin-box-body">
      <p style="margin-bottom:1rem; color:#555; font-size:0.9rem;">
        Click the button below to clear the visibility of current items in the Deleted view.
        This hides them from your dashboard without removing them from the database.
      </p>
      <button class="login-btn" id="hide-deleted-btn" style="max-width:350px; background:#c0392b; border-color:#c0392b;">
        REMOVE ALL CURRENT DELETED ORDERS FROM VIEW
      </button>
      <div id="cleanup-msg" style="margin-top:1rem; display:none; color:#155724; font-weight:bold;"></div>
    </div>
  </div>
</div>

<script is:inline>
  // --- AUTH & LOGOUT ---
  document.addEventListener('DOMContentLoaded', function() {
    if (sessionStorage.getItem('admin_auth') !== 'true') {
      window.location.href = '/admin/login';
      return;
    }
    document.getElementById('logout-btn').addEventListener('click', function(e) {
      e.preventDefault();
      sessionStorage.removeItem('admin_auth');
      window.location.href = '/admin/login';
    });

    // --- CLEANUP DELETED ORDERS ---
    document.getElementById('hide-deleted-btn').addEventListener('click', function() {
      if (!confirm('Hide all current deleted orders from view?')) return;
      localStorage.setItem('indscent_deleted_hide_cutoff', new Date().toISOString());
      var msg = document.getElementById('cleanup-msg');
      msg.textContent = 'Done! Deleted orders hidden from view.';
      msg.style.display = 'block';
      setTimeout(function() { msg.style.display = 'none'; }, 3500);
    });
  });

  // --- CSV EXPORT IMPLEMENTATION ---
  function triggerExport(targetName) {
    var msg = document.getElementById('export-msg');
    msg.style.display = 'block';
    msg.style.color = '#333';
    msg.textContent = 'Fetching raw records...';

    fetch('/api/export-csv?target=' + targetName)
      .then(res => res.json())
      .then(response => {
        if (response.error) throw new Error(response.error);
        var data = response.data;
        if (!data || data.length === 0) {
          msg.textContent = 'Target table contains zero records.';
          msg.style.color = '#c0392b';
          return;
        }

        var headers = Object.keys(data[0]);
        var csvContent = headers.join(',') + '\n';
        data.forEach(function(row) {
          var rowValues = headers.map(function(h) {
            var value = row[h] === null ? '' : row[h];
            if (typeof value === 'string' && value.includes(',')) {
              return '"' + value.replace(/"/g, '""') + '"';
            }
            return value;
          });
          csvContent += rowValues.join(',') + '\n';
        });

        var blob = new Blob([csvContent], { type: 'text/csv; charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", targetName + "_backup.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        msg.textContent = 'Backup file downloaded successfully!';
        msg.style.color = '#155724';
      })
      .catch(err => {
        msg.textContent = 'Export failed: ' + err.message;
        msg.style.color = '#c0392b';
      });
  }

  document.getElementById('export-fragrances-btn').addEventListener('click', function() {
    triggerExport('fragrances');
  });
  document.getElementById('export-products-btn').addEventListener('click', function() {
    triggerExport('products');
  });

  // --- CSV IMPORT IMPLEMENTATION ---
  document.getElementById('upload-btn').addEventListener('click', function() {
    var fileInput = document.getElementById('csv-file');
    var file = fileInput.files[0];
    var targetTable = document.getElementById('import-target').value;
    var msg = document.getElementById('upload-msg');
    var preview = document.getElementById('preview-container');
    var previewTable = document.getElementById('preview-table');

    if (!file) {
      msg.style.display = 'block';
      msg.style.color = '#c0392b';
      msg.textContent = 'Please select an updated CSV template file first.';
      return;
    }

    var reader = new FileReader();
    reader.onload = function(e) {
      var lines = e.target.result.split('\n').filter(l => l.trim());
      if (lines.length < 2) {
        msg.style.display = 'block';
        msg.style.color = '#c0392b';
        msg.textContent = 'The uploaded file contains no data rows.';
        return;
      }

      var headers = lines[0].split(',').map(h => h.trim().toLowerCase());
      if (targetTable === 'fragrances' && (!headers.includes('name') || !headers.includes('gender'))) {
        msg.style.display = 'block';
        msg.style.color = '#c0392b';
        msg.textContent = 'Fragrances template requires at minimum "name" and "gender" headers.';
        return;
      }
      if (targetTable === 'products' && (!headers.includes('name') || !headers.includes('price'))) {
        msg.style.display = 'block';
        msg.style.color = '#c0392b';
        msg.textContent = 'Products template requires at minimum "name" and "price" headers.';
        return;
      }

      var payloadRows = [];
      for (var i = 1; i < lines.length; i++) {
        var cols = lines[i].split(',');
        var obj = {};
        headers.forEach(function(header, idx) {
          if (cols[idx] !== undefined) {
            var value = cols[idx].trim();
            if (header === 'active' || header === 'price') {
              obj[header] = parseInt(value) || 0;
            } else {
              obj[header] = value;
            }
          }
        });
        payloadRows.push(obj);
      }

      var previewHtml = '<table class="admin-table"><thead><tr>';
      headers.forEach(function(h) { previewHtml += '<th>' + h.toUpperCase() + '</th>'; });
      previewHtml += '</tr></thead><tbody>';
      payloadRows.slice(0, 10).forEach(function(row) {
        previewHtml += '<tr>';
        headers.forEach(function(h) { previewHtml += '<td>' + (row[h] !== undefined ? row[h] : '') + '</td>'; });
        previewHtml += '</tr>';
      });
      if (payloadRows.length > 10) {
        previewHtml += '<tr><td colspan="' + headers.length + '" style="color:#888; font-style:italic;">... and ' + (payloadRows.length - 10) + ' more rows staging.</td></tr>';
      }
      previewHtml += '</tbody></table>';
      previewTable.innerHTML = previewHtml;
      preview.style.display = 'block';
      msg.style.display = 'block';
      msg.style.color = '#333';
      msg.textContent = 'Pushing ' + payloadRows.length + ' rows directly into Cloudflare D1 SQL...';

      fetch('/api/import-csv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ target: targetTable, rows: payloadRows })
      })
      .then(res => res.json())
      .then(data => {
        if (data.error) throw new Error(data.error);
        msg.style.color = '#155724';
        msg.textContent = 'Success! Live database overwritten. ' + data.count + ' records verified live.';
      })
      .catch(err => {
        msg.style.color = '#c0392b';
        msg.textContent = 'Database Write Error: ' + err.message;
      });
    };
    reader.readAsText(file);
  });

  function downloadPdf(response, filename) {
    return response.blob().then(function(blob) {
      const href = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = href;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(href);
    });
  }

  document.getElementById('generate-brochure-btn').addEventListener('click', function() {
    const msg = document.getElementById('brochure-msg');
    const key = document.getElementById('brochure-upload-key').value;
    if (!key) {
      msg.style.display = 'block';
      msg.style.color = '#c0392b';
      msg.textContent = 'Enter the PDF management key first.';
      return;
    }
    msg.style.display = 'block';
    msg.style.color = '#333';
    msg.textContent = 'Generating brochure PDF...';

    fetch('/api/brochure-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
      body: JSON.stringify({ action: 'generate' })
    })
      .then(function(res) {
        if (!res.ok) return res.json().then(function(data) { throw new Error(data.error || 'Failed'); });
        return downloadPdf(res, 'indscent-brochure.pdf').then(function() {
          msg.style.color = '#155724';
          msg.textContent = 'New brochure PDF generated and downloaded successfully.';
        });
      })
      .catch(function(err) {
        msg.style.color = '#c0392b';
        msg.textContent = 'PDF generation failed: ' + err.message;
      });
  });

  document.getElementById('upload-brochure-btn').addEventListener('click', function() {
    const msg = document.getElementById('brochure-msg');
    const key = document.getElementById('brochure-upload-key').value;
    const fileInput = document.getElementById('brochure-file');
    const file = fileInput.files[0];
    if (!key || !file) {
      msg.style.display = 'block';
      msg.style.color = '#c0392b';
      msg.textContent = !key ? 'Enter the PDF management key first.' : 'Choose a PDF file to upload.';
      return;
    }

    const formData = new FormData();
    formData.append('file', file);
    msg.style.display = 'block';
    msg.style.color = '#333';
    msg.textContent = 'Uploading PDF to the live brochure...';

    fetch('/api/brochure-pdf', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + key },
      body: formData
    })
      .then(function(res) {
        return res.json().then(function(data) {
          if (!res.ok) throw new Error(data.error || 'Upload failed.');
          return data;
        });
      })
      .then(function(data) {
        msg.style.color = '#155724';
        msg.textContent = data.message || 'Uploaded PDF is now the live brochure.';
        fileInput.value = '';
      })
      .catch(function(err) {
        msg.style.color = '#c0392b';
        msg.textContent = 'PDF upload failed: ' + err.message;
      });
  });

  document.getElementById('use-previous-brochure-btn').addEventListener('click', function() {
    const msg = document.getElementById('brochure-msg');
    msg.style.display = 'block';
    msg.style.color = '#333';
    msg.textContent = 'Fetching previous brochure PDF...';

    fetch('/api/brochure-pdf?previous=1')
      .then(function(res) {
        if (!res.ok) return res.json().then(function(data) { throw new Error(data.error || 'No previous PDF found'); });
        return downloadPdf(res, 'indscent-previous-brochure.pdf').then(function() {
          msg.style.color = '#155724';
          msg.textContent = 'Previous brochure PDF downloaded successfully.';
        });
      })
      .catch(function(err) {
        msg.style.color = '#c0392b';
        msg.textContent = 'Previous PDF not available: ' + err.message;
      });
  });
</script>
</BaseLayout>
